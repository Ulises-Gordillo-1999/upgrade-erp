# ==============================================================================
# UPGRADE ERP/CRM - Variables de Entorno de Ejemplo (Producción / Coolify)
# ==============================================================================

# 1. Base de Datos PostgreSQL
POSTGRES_USER=upgrade_admin
POSTGRES_PASSWORD=genera_aqui_una_password_segura_de_al_menos_24_caracteres
POSTGRES_DB=upgrade_prod_db

# String de Conexión interna utilizada por la aplicación Next.js y Drizzle ORM
DATABASE_URL=postgresql://upgrade_admin:genera_aqui_una_password_segura_de_al_menos_24_caracteres@postgres:5432/upgrade_prod_db

# 2. Clave de Cifrado Simétrico AES-256 para Bóveda y JWT de Sesión
# Generar una clave segura aleatoria en bash con: openssl rand -base64 32
ENCRYPTION_KEY=clave_criptografica_aes256_super_segura_minimo_32_bytes_xyz123!

# 3. URL Pública de la Aplicación (Dominio configurado con SSL en Coolify / Hetzner)
NEXT_PUBLIC_APP_URL=https://erp.upgrade.com.ar

# 4. Puerto de Exposición del Contenedor (Opcional, por defecto 3000)
APP_PORT=3000
